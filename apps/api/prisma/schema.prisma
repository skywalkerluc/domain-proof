generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model DomainVerification {
  id             String   @id @default(uuid()) @db.Uuid
  domain         String
  challengeToken String   @default(dbgenerated("translate(rtrim(encode(gen_random_bytes(32), 'base64'), '='), '+/', '-_')")) @map("challenge_token")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("domain_verifications")
}
